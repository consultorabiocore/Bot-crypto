{
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": 10,
  "tradable_balance_ratio": 0.9,
  "dry_run": true,
  "dry_run_wallet": 35,
  "fiat_display_currency": "USD",
  "trading_mode": "spot",
  "cancel_open_orders_on_exit": true,
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "bid",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "ask",
    "use_order_book": true,
    "order_book_top": 1
  },
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "verbosity": "info",
    "enable_openapi": false
  },
  "datadir": "user_data",
  "db_url": "sqlite:///user_data/trades.db",
  "user_data_dir": "user_data",
  "initial_state": "running"
}
