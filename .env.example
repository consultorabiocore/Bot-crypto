# Freqtrade / Binance environment overrides
# Copy this file to .env and NEVER commit the real .env file.

# Binance API keys. For safety, create an API key with trading permission only.
# Do NOT enable withdrawals on the API key used by the bot.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# Safe default: simulation only.
FREQTRADE__DRY_RUN=true

# Only set this locally when you intentionally want to unlock the live-start path.
ALLOW_LIVE_TRADING=NO

# Optional Telegram settings
FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=
